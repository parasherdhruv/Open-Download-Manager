{
  "$schema": "https://schema.tauri.app/config/2.12.5",
  "productName": "Open Download Manager",
  "version": "0.0.0",
  "identifier": "org.opendownloadmanager.desktop",
  "build": {
    "beforeBuildCommand": "corepack pnpm run build",
    "beforeDevCommand": "corepack pnpm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "capabilities": [],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self' http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'; frame-ancestors 'none'"
    },
    "windows": [
      {
        "label": "main",
        "title": "Open Download Manager",
        "width": 960,
        "height": 680,
        "minWidth": 360,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "active": false
  }
}
