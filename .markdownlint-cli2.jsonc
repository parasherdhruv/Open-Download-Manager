{
  "$schema": "https://raw.githubusercontent.com/DavidAnson/markdownlint-cli2/v0.24.0/schema/markdownlint-cli2-config-schema.json",
  "config": {
    "default": true,
    "MD013": false,
    "MD024": {
      "siblings_only": true,
    },
  },
  "fix": false,
  "globs": ["**/*.md"],
  "ignores": [
    ".git/**",
    ".kilo/**",
    "**/node_modules/**",
    "**/target/**",
    "**/gen/schemas/**",
    "**/dist/**",
    "**/coverage/**",
    "**/playwright-report/**",
    "**/test-results/**",
    "**/blob-report/**",
    "**/.cache/**",
    "**/.vite/**",
    "**/.playwright/**",
    "Cargo.lock",
    "pnpm-lock.yaml",
    "LICENSE",
    "blueprint.md",
  ],
  "noBanner": true,
  "noInlineConfig": true,
  "noProgress": true,
}
